#!/usr/bin/env bash
set -euo pipefail

# Decide whether AI agents worked on a pull request.
#
#   gh api .../pulls/<n>/commits --jq '.[].commit.message' | bash detect-ai-assist
#
# Commit messages arrive on stdin and PR_AUTHOR comes from the environment.
# Exit 0 and print the reason when agents worked on it, exit 1 when nothing
# says so. Two signals count, in this order:
#
#   1. a Co-authored-by, Assisted-by or Generated-by trailer naming an agent
#   2. a pull request opened by an agent's own bot account
#
# A tool that leaves neither trace can be labelled by hand.
#
# Free text that merely mentions a tool is not a signal: only trailers count.

tools='claude|anthropic|copilot|codex|openai|gemini|cursor|opencode|aider|devin|windsurf|cline'

commits=$(cat)

if grep -Eiq "^(co-authored-by|assisted-by|generated-by):.*(${tools})" <<<"$commits"; then
  echo "a commit trailer names an AI agent"
  exit 0
fi

if grep -Eiq "^(${tools})[^[:space:]]*(\[bot\])?$|^app/(${tools})" <<<"${PR_AUTHOR:-}"; then
  echo "the pull request was opened by an AI agent's account"
  exit 0
fi

exit 1
