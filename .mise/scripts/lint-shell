#!/usr/bin/env bash
set -euo pipefail

shell_files=()
while IFS= read -r -d '' shell_file; do
  [[ -f "$shell_file" ]] || continue
  if [[ "$shell_file" == *.sh ]] || head -n 1 "$shell_file" | grep -q '^#!/usr/bin/env bash$'; then
    shell_files+=("$shell_file")
  fi
done < <(git ls-files -z --cached --others --exclude-standard -- '*.sh' '**/*.sh' '.mise/scripts/*')

if ((${#shell_files[@]} == 0)); then
  exit 0
fi

report_file="reports/lint/shellcheck.txt"
mkdir -p "$(dirname "$report_file")"

if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
  set +e
  output=$(shellcheck --format=json1 "${shell_files[@]}")
  result=$?
  set -e
  if ((result > 1)); then
    printf '%s\n' "$output" >&2
    exit "$result"
  fi
  jq -r '
    def property: gsub("%"; "%25") | gsub("\\r"; "%0D") | gsub("\\n"; "%0A") | gsub(":"; "%3A") | gsub(","; "%2C");
    def data: gsub("%"; "%25") | gsub("\\r"; "%0D") | gsub("\\n"; "%0A");
    .comments[]
    | "::error file=\(.file | property),line=\(.line),col=\(.column),title=ShellCheck SC\(.code)::\(.message | data)"
  ' <<< "$output"
  shellcheck --format=gcc "${shell_files[@]}" > "$report_file" 2>&1 || true
  exit "$result"
fi

if output=$(shellcheck "${shell_files[@]}" 2>&1); then
  result=0
else
  result=$?
fi
printf '%s\n' "${output:-No issues found}" | tee "$report_file"
exit "$result"
